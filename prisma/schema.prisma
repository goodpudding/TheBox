// Prisma schema for The Box Portal.
// SQLite in dev (DATABASE_URL file), Cloudflare D1 in prod via the D1 driver adapter — no engine-specific features.
// Schema changes: edit here, then regenerate migrations/ (see README → Database).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Auth.js ──────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Domain ───────────────────────────────────────────────────────────────────

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  emailVerified            DateTime?
  image                    String?
  firstName                String    @default("")
  lastName                 String    @default("")
  displayName              String    @default("")
  phone                    String?
  role                     String    @default("member") // member | staff | admin
  status                   String    @default("pending") // active | lapsed | suspended | pending
  tier                     String?
  billingInterval          String?
  householdPrimaryUserId   String?
  shopAccess               Boolean   @default(false)
  /** Orthogonal instructor flag — not a role replacement. */
  isTeacher                Boolean   @default(false)
  dayPassCreditExpiresAt   DateTime?
  scholarshipExpiresAt     DateTime?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  profileComplete          Boolean   @default(false)
  notes                    String?
  /** Shop-floor PIN (scrypt). Never store plaintext. */
  kioskPinHash             String?
  /** True after a staff reset until the member chooses their own PIN. */
  kioskPinMustChange       Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  householdPrimary User?  @relation("Household", fields: [householdPrimaryUserId], references: [id])
  householdMembers User[] @relation("Household")

  accounts               Account[]
  sessions               Session[]
  badges                 Badge[]
  waiverSignatures       WaiverSignature[]
  policyAcknowledgements PolicyAcknowledgement[]
  userCertifications     UserCertification[]
  checkoffsGiven         UserCertification[]     @relation("CheckoffBy")
  revocationsGiven       UserCertification[]     @relation("RevokedBy")
  reservations           Reservation[]           @relation("ReservationUser")
  reservationsCreated    Reservation[]           @relation("ReservationCreatedBy")
  maintenanceCreated     MaintenanceBlock[]
  usageSessions          UsageSession[]
  accessLogs             AccessLog[]
  classesInstructed      ClassSession[]
  defaultClassSettings   OrgSettings[]           @relation("DefaultClassInstructor")
  bookings               Booking[]
  bookingsMarkedPaid     Booking[]               @relation("BookingPaidBy")
  lessonProgress         LessonProgress[]
  videoWatches           VideoWatch[]
  quizAttempts           QuizAttempt[]
  volunteerInterests     VolunteerInterest[]
  volunteerReviews       VolunteerInterest[]     @relation("VolunteerReviewedBy")
  auditEventsAsActor     AuditEvent[]            @relation("AuditActor")
  auditEventsAsSubject   AuditEvent[]            @relation("AuditSubject")
  classInterestProposed  ClassInterestBoard[]    @relation("InterestProposedBy")
  classInterestInstruct  ClassInterestBoard[]    @relation("InterestInstructorHint")
  classInterestReviewed  ClassInterestBoard[]    @relation("InterestReviewedBy")
  classInterestSignups   ClassInterestSignup[]
  bountiesRequested      Bounty[]               @relation("BountyRequester")
  bountiesClaimed        Bounty[]               @relation("BountyClaimedBy")
  creditLedgerEntries    CreditLedgerEntry[]
  creditGrantsGiven      CreditLedgerEntry[]     @relation("CreditActor")
  workstationSessions    WorkstationSession[]
  workstationLaunches    WorkstationLaunch[]
  loginChallengesApproved WorkstationLoginChallenge[]
  equipmentJobs          EquipmentJob[]
  inventoryItemsCreated  InventoryItem[]         @relation("ItemsCreated")
  inventoryItemsReviewed InventoryItem[]         @relation("ItemsReviewed")
  inventoryPhotos        ItemPhoto[]             @relation("ItemPhotosUploaded")
  inventoryEvents        ItemEvent[]             @relation("ItemEvents")
  areaStewardships       AreaSteward[]           @relation("AreaStewardships")
}

model Badge {
  id        String    @id
  uid       String    @unique
  label     String?
  userId    String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User?     @relation(fields: [userId], references: [id])
  usageSessions UsageSession[]
}

model WaiverSignature {
  id            String    @id
  userId        String
  version       String
  signedAt      DateTime
  fullNameTyped String
  ip            String
  userAgent     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id])
}

model PolicyAcknowledgement {
  id              String    @id
  userId          String
  policySlug      String
  version         String
  acknowledgedAt  DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  user            User      @relation(fields: [userId], references: [id])
}

model Certification {
  id                       String    @id
  slug                     String    @unique
  name                     String
  description              String
  knowledgeOnly            Boolean   @default(false)
  requiresCertificationIds String // JSON array
  expiryMonths             Int?
  sortOrder                Int       @default(0)
  active                   Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?
  userCertifications       UserCertification[]
  learningModules          LearningModule[]
}

model UserCertification {
  id               String    @id
  userId           String
  certificationId  String
  status           String
  knowledgePassedAt DateTime?
  checkedOffAt     DateTime?
  checkedOffById   String?
  expiresAt        DateTime?
  revokedAt        DateTime?
  revokedById      String?
  revokeReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id])
  certification    Certification @relation(fields: [certificationId], references: [id])
  checkedOffBy     User?     @relation("CheckoffBy", fields: [checkedOffById], references: [id])
  revokedBy        User?     @relation("RevokedBy", fields: [revokedById], references: [id])

  @@unique([userId, certificationId])
}

model Machine {
  id                        String    @id
  name                      String
  area                      String
  requiredCertificationIds  String // JSON array
  readerKey                 String    @unique
  active                    Boolean   @default(true)
  reservationRecommended    Boolean   @default(false)
  reservationRequired       Boolean   @default(false)
  attendedOperationRequired Boolean   @default(false)
  locationLabel             String    @default("")
  gettingStartedVideoUrl    String?
  /** Max single reservation length in hours; null = use org maxHoursPerDay. */
  maxReservationHours       Int?
  sortOrder                 Int       @default(0)
  /** Optional override; null means use area default in app code. */
  hourlyRateCents           Int?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?
  reservations              Reservation[]
  maintenanceBlocks         MaintenanceBlock[]
  usageSessions             UsageSession[]
  accessLogs                AccessLog[]
  billedWorkstations        Workstation[]          @relation("WorkstationBilledMachine")
  softwareMaps              MachineSoftwareMap[]
  launches                  WorkstationLaunch[]
  equipmentJobs             EquipmentJob[]
}

model Reservation {
  id           String    @id
  userId       String
  machineId    String
  startsAt     DateTime
  endsAt       DateTime
  status       String
  createdById  String
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  user         User      @relation("ReservationUser", fields: [userId], references: [id])
  machine      Machine   @relation(fields: [machineId], references: [id])
  createdBy    User      @relation("ReservationCreatedBy", fields: [createdById], references: [id])
  usageSessions UsageSession[]
}

model MaintenanceBlock {
  id          String    @id
  machineId   String
  startsAt    DateTime
  endsAt      DateTime
  reason      String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  machine     Machine   @relation(fields: [machineId], references: [id])
  createdBy   User      @relation(fields: [createdById], references: [id])
}

model UsageSession {
  id            String    @id
  userId        String
  machineId     String
  badgeId       String
  startedAt     DateTime
  endedAt       DateTime?
  reservationId String?
  endedBy       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id])
  machine       Machine   @relation(fields: [machineId], references: [id])
  badge         Badge     @relation(fields: [badgeId], references: [id])
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  creditLedgerEntries CreditLedgerEntry[]
}

model AccessLog {
  id                 String    @id
  readerKey          String
  machineId          String?
  badgeUid           String
  userId             String?
  allow              Boolean
  reason             String?
  reservationNotice  String?
  sessionId          String?
  requestedAt        DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  machine            Machine?  @relation(fields: [machineId], references: [id])
  user               User?     @relation(fields: [userId], references: [id])
}

model ClassSession {
  id                            String    @id
  title                         String
  slug                          String    @unique
  descriptionSlug               String
  category                      String
  instructorId                  String
  startsAt                      DateTime
  endsAt                        DateTime
  capacity                      Int
  priceCents                    Int       @default(0)
  zeffyUrl                      String?
  zeffyCampaignId               String?
  /** Occurrence within the campaign. "default" when Zeffy has a single date. */
  zeffyOccurrenceId             String?
  /** zeffy | csv | admin. CSV rows are the retired sheet import. */
  source                        String    @default("admin")
  googleEventId                 String?
  googleCalendarId              String?
  syncedAt                      DateTime?
  cancelledAt                   DateTime?
  /** JSON array of field names staff changed; Zeffy sync will not overwrite them. */
  staffEditedFields             String?
  prerequisiteCertificationIds  String // JSON array
  location                      String
  cancellationCutoffHours       Int?
  published                     Boolean   @default(true)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  deletedAt                     DateTime?
  instructor                    User      @relation(fields: [instructorId], references: [id])
  bookings                      Booking[]

  @@unique([zeffyCampaignId, zeffyOccurrenceId])
  @@index([zeffyCampaignId])
}

model Booking {
  id                    String    @id
  classSessionId        String
  userId                String
  status                String
  waitlistPosition      Int?
  paidAt                DateTime?
  paidMarkedById        String?
  zeffyPaymentId        String?
  paymentHoldExpiresAt  DateTime?
  cancelledAt           DateTime?
  attendedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  classSession          ClassSession @relation(fields: [classSessionId], references: [id])
  user                  User      @relation(fields: [userId], references: [id])
  paidMarkedBy          User?     @relation("BookingPaidBy", fields: [paidMarkedById], references: [id])
  creditLedgerEntries   CreditLedgerEntry[]

  @@index([zeffyPaymentId])
}

/** Append-only in-app wallet. Zeffy never holds this balance. Signed cents. */
model CreditLedgerEntry {
  id              String    @id
  userId          String
  kind            String
  amountCents     Int
  sourcePaymentId      String?
  usageSessionId       String?
  workstationSessionId String? @unique
  equipmentJobId       String?
  bookingId            String?
  actorId              String?
  note            String?
  occurredAt      DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user                User                 @relation(fields: [userId], references: [id])
  actor               User?                @relation("CreditActor", fields: [actorId], references: [id])
  usageSession        UsageSession?        @relation(fields: [usageSessionId], references: [id])
  workstationSession  WorkstationSession?  @relation(fields: [workstationSessionId], references: [id])
  equipmentJob        EquipmentJob?        @relation(fields: [equipmentJobId], references: [id])
  booking             Booking?             @relation(fields: [bookingId], references: [id])

  @@index([userId])
  @@index([sourcePaymentId])
  @@index([usageSessionId])
  @@index([equipmentJobId])
  @@index([bookingId])
}

model ClassInterestBoard {
  id                       String    @id
  title                    String
  summary                  String
  category                 String
  status                   String    @default("pending")
  threshold                Int       @default(8)
  proposedByUserId         String?
  contactName              String
  contactEmail             String
  instructorHintUserId     String?
  opensAt                  DateTime?
  closesAt                 DateTime?
  scheduledClassSessionId  String?
  priorityBookingEndsAt    DateTime?
  resuggestedFromId        String?
  reviewedById             String?
  reviewedAt               DateTime?
  staffNotes               String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  proposedBy     User?                 @relation("InterestProposedBy", fields: [proposedByUserId], references: [id])
  instructorHint User?                 @relation("InterestInstructorHint", fields: [instructorHintUserId], references: [id])
  reviewedBy     User?                 @relation("InterestReviewedBy", fields: [reviewedById], references: [id])
  signups        ClassInterestSignup[]

  @@index([status])
  @@index([scheduledClassSessionId])
}

model ClassInterestSignup {
  id          String    @id
  boardId     String
  userId      String?
  email       String
  displayName String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  board ClassInterestBoard @relation(fields: [boardId], references: [id])
  user  User?              @relation(fields: [userId], references: [id])

  @@index([boardId])
  @@index([email])
}

model ZeffyWebhookEvent {
  id          String   @id
  type        String
  paymentId   String?
  status      String
  detail      String?
  payloadJson String
  receivedAt  DateTime @default(now())
  processedAt DateTime?

  @@index([paymentId])
}

model LearningModule {
  id                    String    @id
  slug                  String    @unique
  title                 String
  summary               String
  certificationId       String
  knowledgeOnly         Boolean   @default(false)
  published             Boolean   @default(false)
  equipmentStatus       String    @default("confirmed")
  passThresholdPercent  Int       @default(80)
  attemptLimit          Int       @default(3)
  sortOrder             Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  certification         Certification @relation(fields: [certificationId], references: [id])
  lessons               Lesson[]
  questions             Question[]
  quizAttempts          QuizAttempt[]
}

model Lesson {
  id                String    @id
  moduleId          String
  slug              String
  title             String
  contentSlug       String
  sortOrder         Int       @default(0)
  estimatedMinutes  Int       @default(10)
  gap               Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  module            LearningModule @relation(fields: [moduleId], references: [id])
  progress          LessonProgress[]
  videos            LessonVideo[]

  @@unique([moduleId, slug])
}

model LessonVideo {
  id              String    @id
  lessonId        String
  order           Int       @default(0)
  provider        String    @default("youtube")
  youtubeId       String
  url             String
  title           String
  channel         String
  role            String    @default("primary")
  condition       String?
  durationSeconds Int?
  verifiedAt      DateTime?
  staffReviewed   Boolean   @default(false)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  lesson          Lesson    @relation(fields: [lessonId], references: [id])
  watches         VideoWatch[]

  @@index([lessonId])
}

model Question {
  id                 String    @id
  moduleId           String
  prompt             String
  choices            String // JSON array
  correctIndex       Int
  correctIndexes     String? // JSON array for multi-select
  explanation        String?
  active             Boolean   @default(true)
  safetyCritical     Boolean   @default(false)
  source             String    @default("video")
  sourceVideoId      String?
  verifyAgainstVideo Boolean   @default(true)
  answerPending      Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  module             LearningModule @relation(fields: [moduleId], references: [id])
}

model LessonProgress {
  id          String    @id
  userId      String
  lessonId    String
  completedAt DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id])
  lesson      Lesson    @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

model VideoWatch {
  id        String    @id
  userId    String
  videoId   String
  watchedAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
  video     LessonVideo @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}

model QuizAttempt {
  id                      String    @id
  userId                  String
  moduleId                String
  questionIds             String // JSON array
  answers                 String // JSON array
  scorePercent            Int
  passed                  Boolean
  thresholdMet            Boolean   @default(false)
  safetyCriticalMissedIds String? // JSON array
  startedAt               DateTime
  submittedAt             DateTime
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?
  user                    User      @relation(fields: [userId], references: [id])
  module                  LearningModule @relation(fields: [moduleId], references: [id])
}

model ContentPage {
  id           String    @id
  notionId     String?
  googleFileId String?   @unique
  slug         String    @unique
  title        String
  html         String
  markdownPath String?
  category     String
  version      String    @default("1")
  syncedAt     DateTime?
  published    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model VolunteerRole {
  id          String    @id
  slug        String    @unique
  title       String
  contentSlug String
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  interests   VolunteerInterest[]
}

model VolunteerInterest {
  id           String    @id
  name         String
  email        String
  phone        String?
  roleId       String?
  message      String
  status       String    @default("new")
  userId       String?
  reviewedById String?
  reviewedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  role         VolunteerRole? @relation(fields: [roleId], references: [id])
  user         User?     @relation(fields: [userId], references: [id])
  reviewedBy   User?     @relation("VolunteerReviewedBy", fields: [reviewedById], references: [id])
}

model Bounty {
  id              String    @id
  title           String
  description     String
  requesterName   String
  requesterEmail  String
  businessName    String?
  userId          String?
  status          String    @default("open") // open | claimed | completed
  claimedByUserId String?
  claimedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  requester       User?     @relation("BountyRequester", fields: [userId], references: [id])
  claimedBy       User?     @relation("BountyClaimedBy", fields: [claimedByUserId], references: [id])

  @@index([status])
  @@index([claimedByUserId])
}

model MembershipProduct {
  id               String    @id
  tier             String
  name             String
  summary          String
  priceCents       Int
  billingInterval  String
  annualPriceCents Int?
  shopAccess       Boolean   @default(true)
  phase            Int       @default(1)
  visibleOnJoin    Boolean   @default(true)
  joinable         Boolean   @default(true)
  highlight        Boolean   @default(false)
  sortOrder        Int       @default(0)
  isAddOn          Boolean   @default(false)
  cappedSeats      Int?
  zeffyCampaignId  String?
  zeffyRateId      String?
  zeffyUrl         String?
  /** Cents granted on each succeeded membership payment. Plus = 5000. */
  creditGrantCents Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([zeffyCampaignId])
  @@index([zeffyRateId])
}

model OrgSettings {
  id                              String   @id @default("default")
  orgName                         String
  paymentUrl                      String
  donationUrl                     String
  scholarshipDonationUrl          String
  contactEmail                    String
  hoursContentSlug                String
  currentWaiverVersion            String
  memberExpectationsPolicySlug    String
  quizPassThresholdPercent        Int      @default(80)
  quizAttemptLimit                Int      @default(3)
  quizQuestionCount               Int      @default(10)
  requireSafetyCriticalAll        Boolean  @default(true)
  classCancellationCutoffHours    Int      @default(24)
  paymentHoldHours                Int      @default(48)
  reservationHorizonDays          Int      @default(14)
  maxHoursPerDay                  Int      @default(3)
  maxOpenReservations             Int      @default(3)
  reservationSlotMinutes          Int      @default(30)
  communitySeatCap                Int      @default(12)
  makerMonthlyCents               Int      @default(4000)
  patronScholarshipSurchargeCents Int      @default(2000)
  scholarshipFundBalanceCents     Int      @default(0)
  scholarshipSeatsAwarded         Int      @default(0)
  showPhase3Tiers                 Boolean  @default(true)
  /** Used when Zeffy does not name an instructor. */
  defaultInstructorId             String?
  defaultInstructor               User?    @relation("DefaultClassInstructor", fields: [defaultInstructorId], references: [id])
  /** Seats when a Zeffy event has no rate seat counts. */
  defaultClassCapacity            Int      @default(8)
  updatedAt                       DateTime @updatedAt
}

model AuditEvent {
  id            String    @id
  action        String
  actorId       String?
  subjectUserId String?
  entityType    String
  entityId      String
  metadata      String? // JSON
  occurredAt    DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  actor         User?     @relation("AuditActor", fields: [actorId], references: [id])
  subjectUser   User?     @relation("AuditSubject", fields: [subjectUserId], references: [id])
}

model PromoSlide {
  id        String    @id
  title     String
  body      String
  imageUrl  String?
  qrUrl     String?
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model DisplayConfig {
  id                         String   @id @default("default")
  panelOrder                 String // JSON array of DisplayPanelId
  cadenceSeconds             Int      @default(12)
  pinnedPanel                String?
  nameDisplayMode            String   @default("first")
  membershipEveryNRotations  Int      @default(3)
  updatedAt                  DateTime @updatedAt
}

// ── Shared Windows workstations (Tauri kiosk) ────────────────────────────────

model Workstation {
  id                 String    @id
  name               String
  deviceId           String    @unique
  location           String    @default("")
  active             Boolean   @default(true)
  /** Primary machine at this desk (software/access). Login does not bill. */
  billedMachineId    String
  idleLockMinutes    Int       @default(10)
  idleLogoutMinutes  Int       @default(30)
  lastSeenAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  billedMachine Machine               @relation("WorkstationBilledMachine", fields: [billedMachineId], references: [id])
  sessions      WorkstationSession[]
  softwareMaps  MachineSoftwareMap[]
  launches      WorkstationLaunch[]
  challenges    WorkstationLoginChallenge[]
  jobs          EquipmentJob[]
}

model WorkstationSession {
  id              String    @id
  workstationId   String
  userId          String
  tokenHash       String    @unique
  billedMachineId String
  startedAt       DateTime
  endedAt         DateTime?
  endedBy         String?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  workstation  Workstation         @relation(fields: [workstationId], references: [id])
  user         User                @relation(fields: [userId], references: [id])
  creditLedger CreditLedgerEntry?
  launches     WorkstationLaunch[]
  jobs         EquipmentJob[]

  @@index([workstationId, endedAt])
  @@index([userId])
}

model WorkstationLaunch {
  id            String    @id
  workstationId String
  sessionId     String
  userId        String
  machineId     String
  softwareMapId String?
  allowed       Boolean
  reason        String
  exeName       String
  createdAt     DateTime  @default(now())

  workstation Workstation         @relation(fields: [workstationId], references: [id])
  session     WorkstationSession  @relation(fields: [sessionId], references: [id])
  user        User                @relation(fields: [userId], references: [id])
  machine     Machine             @relation(fields: [machineId], references: [id])
  softwareMap MachineSoftwareMap? @relation(fields: [softwareMapId], references: [id])

  @@index([sessionId])
}

model MachineSoftwareMap {
  id            String    @id
  machineId     String?
  workstationId String?
  displayName   String
  exeName       String
  exePath       String?
  sortOrder     Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  machine     Machine?            @relation(fields: [machineId], references: [id])
  workstation Workstation?        @relation(fields: [workstationId], references: [id])
  launches    WorkstationLaunch[]
}

model WorkstationLoginChallenge {
  id             String    @id
  workstationId  String
  userCode       String
  expiresAt      DateTime
  approvedUserId String?
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  workstation  Workstation @relation(fields: [workstationId], references: [id])
  approvedUser User?       @relation(fields: [approvedUserId], references: [id])

  @@index([workstationId])
}

/**
 * A machine job — the meter. Desk login is not a job.
 * Charge when the job is sent (estimate), not for sitting at the PC.
 */
model EquipmentJob {
  id                   String    @id
  userId               String
  machineId            String
  workstationId        String?
  workstationSessionId String?
  usageSessionId       String?
  source               String    @default("manual") // manual | mqtt | spooler | estimated
  status               String    @default("completed") // open | completed | cancelled | refunded
  filamentGrams        Float?
  sheets               Int?
  runtimeSeconds       Int?
  /** Cents charged for this sent job. 0 = free / Unlimited. */
  billedCents          Int?
  note                 String?
  startedAt            DateTime
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  user         User                 @relation(fields: [userId], references: [id])
  machine      Machine              @relation(fields: [machineId], references: [id])
  workstation  Workstation?         @relation(fields: [workstationId], references: [id])
  session      WorkstationSession?  @relation(fields: [workstationSessionId], references: [id])
  creditLedgerEntries CreditLedgerEntry[]

  @@index([userId, completedAt])
  @@index([machineId])
}

// ── Inventory (shop stock / materials — not Zeffy billing) ───────────────────
// SQLite: tagNumber is assigned in code (max+1). No @default(autoincrement()).
// Enum-like fields are String to match the rest of this schema.

model InventoryArea {
  id        String          @id @default(cuid())
  slug      String          @unique // "fdm", "sla", "laser", "cnc", "woodshop", "textiles-vinyl", "sublimation"
  name      String
  sortOrder Int             @default(0)
  active    Boolean         @default(true)
  items     InventoryItem[]
  stewards  AreaSteward[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model AreaSteward {
  id        String        @id @default(cuid())
  areaId    String
  area      InventoryArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation("AreaStewardships", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([areaId, userId])
}

model InventoryItem {
  id        String @id @default(cuid())
  tagNumber Int    @unique // displayed as BX-00042; assigned in code for SQLite

  name         String
  model        String?
  manufacturer String?
  serialNumber String?
  noSerial     Boolean @default(false)
  quantity     Int     @default(1)
  isMachine    Boolean @default(false)

  areaId    String?
  area      InventoryArea? @relation(fields: [areaId], references: [id])
  location  String?
  condition String // NEW | GOOD | FAIR | NEEDS_REPAIR | BROKEN
  status    String         @default("ACTIVE") // ACTIVE | IN_REPAIR | OUT_ON_LOAN | MISSING | RETIRED
  notes     String?

  reviewStatus String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById String?
  reviewedBy   User?     @relation("ItemsReviewed", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  rejectReason String?

  acquisitionSource String? // DONATED | PURCHASED | LOANED_IN | UNKNOWN
  acquiredAt        DateTime?
  donorName         String?
  estimatedValue    Float?

  labelPrintedAt DateTime?
  retiredAt      DateTime?
  retiredReason  String?

  createdById String
  createdBy   User   @relation("ItemsCreated", fields: [createdById], references: [id])

  photos ItemPhoto[]
  events ItemEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId])
  @@index([status])
  @@index([reviewStatus])
  @@index([serialNumber])
  @@index([name])
}

model ItemPhoto {
  id           String         @id @default(cuid())
  itemId       String?
  item         InventoryItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind         String // FRONT | SIDE | SERIAL | OTHER
  storageKey   String
  thumbKey     String?
  mimeType     String
  width        Int?
  height       Int?
  uploadedById String
  uploadedBy   User           @relation("ItemPhotosUploaded", fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([itemId])
  @@index([itemId, kind])
  @@index([createdAt])
}

model ItemEvent {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      String // CREATED | UPDATED | APPROVED | REJECTED | …
  actorId   String
  actor     User          @relation("ItemEvents", fields: [actorId], references: [id])
  changes   String? // JSON { field: { from, to } }
  note      String?
  photoId   String?
  createdAt DateTime      @default(now())

  @@index([itemId, createdAt])
  @@index([type])
}
