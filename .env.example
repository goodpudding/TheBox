# Lobby TV display (kiosk). Use a long random string in production.
# Keep DISPLAY_TOKEN and NEXT_PUBLIC_DISPLAY_TOKEN identical.
DISPLAY_TOKEN=dev-display-token-change-me
NEXT_PUBLIC_DISPLAY_TOKEN=dev-display-token-change-me

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo preview host (Vercel etc.): show banner + switch-user bar in production builds
# NEXT_PUBLIC_DEMO_MODE=true

# Data layer: mock (default UI) | prisma
DATA_PROVIDER=mock

# External membership checkout (Zeffy). Not processed in-app.
PAYMENT_URL=https://www.zeffy.com/en-US/donation-form/example-the-box
DONATION_URL=https://www.zeffy.com/en-US/donation-form/example-the-box-donate
SCHOLARSHIP_DONATION_URL=https://www.zeffy.com/en-US/donation-form/example-the-box-scholarship

# Database — SQLite in dev (Prisma). For Postgres, change schema provider + URL.
DATABASE_URL="file:./dev.db"
# DATABASE_URL=postgresql://thebox:thebox@localhost:5432/thebox

# Auth.js magic links
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000
AUTH_EMAIL_SERVER=smtp://127.0.0.1:1025
AUTH_EMAIL_FROM="The Box <thebox@discoverburien.org>"

# Notion CMS sync
NOTION_TOKEN=
NOTION_POLICIES_DB_ID=
NOTION_WAIVER_PAGE_ID=
NOTION_HOURS_PAGE_ID=
NOTION_VOLUNTEER_DB_ID=

# Reservation / booking defaults (also editable in admin settings)
RESERVATION_HORIZON_DAYS=14
MAX_HOURS_PER_DAY=3
MAX_OPEN_RESERVATIONS=3
PAYMENT_HOLD_HOURS=48
