# Lobby TV display (kiosk). Use a long random string in production.
# Keep DISPLAY_TOKEN and NEXT_PUBLIC_DISPLAY_TOKEN identical.
DISPLAY_TOKEN=dev-display-token-change-me
NEXT_PUBLIC_DISPLAY_TOKEN=dev-display-token-change-me

# Machine readers (ESP32). Sent as Authorization: Bearer … or X-Reader-Secret.
READER_SHARED_SECRET=dev-reader-secret-change-me

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo preview host (Vercel etc.): show banner + switch-user bar in production builds
# NEXT_PUBLIC_DEMO_MODE=true

# Data layer: mock (default UI) | prisma
DATA_PROVIDER=mock

# External membership checkout (Zeffy). Not processed in-app.
PAYMENT_URL=https://www.zeffy.com/en-US/donation-form/example-the-box
DONATION_URL=https://www.zeffy.com/en-US/donation-form/example-the-box-donate
SCHOLARSHIP_DONATION_URL=https://www.zeffy.com/en-US/donation-form/example-the-box-scholarship

# Zeffy API + webhooks (automatic calendar / ticket / membership sync)
# Settings → Integrations in Zeffy when you have access.
# Webhook URL: https://YOUR_DOMAIN/api/zeffy/webhook
# Never commit the key. Join falls back to fixture memberships until this is set.
# ZEFFY_API_KEY=
# ZEFFY_WEBHOOK_SECRET=
# Optional override (default https://api.zeffy.com/api/v1)
# ZEFFY_API_BASE=

# Database — SQLite in dev (Prisma). For Postgres, change schema provider + URL.
DATABASE_URL="file:./dev.db"
# DATABASE_URL=postgresql://thebox:thebox@localhost:5432/thebox

# Auth.js magic links
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000
AUTH_EMAIL_SERVER=smtp://127.0.0.1:1025
AUTH_EMAIL_FROM="The Box <thebox@discoverburien.org>"

# Google Drive CMS (learning copy, waiver, policies, flyers, photos)
# Classes come from the Schedule sheet CSV import; Zeffy handles payments.
# One service account with Viewer access to the shared "The Box Website" folder.
# See README → "Google Drive CMS". `npm run sync:google` prints setup help until these are set.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   # whole key JSON on one line, or a path to the .json file
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_CONTENT_INDEX_SHEET_ID=      # optional: Content Index sheet (slug | title | category | doc | published | version)
# GOOGLE_SCHEDULE_SHEET_ID=1ncdYmW0w5XG7Q8pNkBXHdJRd1thiXY016wFgab2T9MA   # reserved for live Sheet sync later

# Notion CMS sync — DEPRECATED (replaced by Google Drive above; script kept for reference)
# NOTION_TOKEN=
# NOTION_POLICIES_DB_ID=
# NOTION_WAIVER_PAGE_ID=
# NOTION_HOURS_PAGE_ID=
# NOTION_VOLUNTEER_DB_ID=

# Reservation / booking defaults (also editable in admin settings)
RESERVATION_HORIZON_DAYS=14
MAX_HOURS_PER_DAY=3
MAX_OPEN_RESERVATIONS=3
PAYMENT_HOLD_HOURS=48
