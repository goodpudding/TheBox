{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "src/worker.ts",
	// Must match the Worker name in the Cloudflare dashboard (Workers & Pages → thebox).
	"name": "thebox",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference binding; the service name must match "name" above.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "thebox"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	// Prisma talks to this through @prisma/adapter-d1 (src/lib/db.ts).
	// Schema lives in migrations/; the deploy command applies them with
	// `wrangler d1 migrations apply thebox-db --remote`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "thebox-db",
			"database_id": "897ead2c-9451-4d4d-8b45-9d2f05708823",
			"migrations_dir": "migrations"
		}
	],
	// Request limits for the endpoints anyone can reach. The names and numbers
	// are mirrored in src/lib/rate-limit.ts, which explains each one; a unit
	// test fails when the two differ. namespace_id is any number not used by
	// another rate limit on this Cloudflare account.
	"ratelimits": [
		{ "name": "RL_PUBLIC_WRITE_ANON", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
		{ "name": "RL_PUBLIC_WRITE_MEMBER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
		{ "name": "RL_SIGNIN_IP", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
		{ "name": "RL_SIGNIN_ADDRESS", "namespace_id": "1004", "simple": { "limit": 3, "period": 60 } },
		{ "name": "RL_QR_START", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
		{ "name": "RL_SYNC_MEMBERSHIP", "namespace_id": "1006", "simple": { "limit": 3, "period": 60 } },
		{ "name": "RL_PIN_ATTEMPT", "namespace_id": "1007", "simple": { "limit": 40, "period": 60 } }
	],
	// Plain-text runtime config. Secrets (AUTH_SECRET, AUTH_RESEND_KEY,
	// ZEFFY_API_KEY, ZEFFY_WEBHOOK_SECRET, DISPLAY_TOKEN, READER_SHARED_SECRET)
	// are set in the dashboard under Settings → Variables and Secrets.
	"vars": {
		"AUTH_URL": "https://discoverburienmakerspace.com",
		"NEXT_PUBLIC_SITE_URL": "https://discoverburienmakerspace.com",
		"AUTH_EMAIL_FROM": "Discover Burien Makerspace <hello@discoverburienmakerspace.com>",
		"PAYMENT_URL": "https://www.zeffy.com/en-US/ticketing/burien-makers-spaces-memberships"
	},
	// Branch preview builds (`npx wrangler preview`). Previews do not inherit
	// production bindings. OpenNext still needs WORKER_SELF_REFERENCE; a missing
	// or stale name (package.json is `the-box-portal`) fails Workers Builds on
	// PRs even when production (`thebox`) is green. D1 is bound here too.
	"previews": {
		"images": {
			"binding": "IMAGES"
		},
		"services": [
			{
				"binding": "WORKER_SELF_REFERENCE",
				"service": "thebox"
			}
		],
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "thebox-db",
				"database_id": "897ead2c-9451-4d4d-8b45-9d2f05708823",
				"migrations_dir": "migrations"
			}
		],
		// Same limits as production: previews write to the same database.
		"ratelimits": [
			{ "name": "RL_PUBLIC_WRITE_ANON", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
			{ "name": "RL_PUBLIC_WRITE_MEMBER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
			{ "name": "RL_SIGNIN_IP", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
			{ "name": "RL_SIGNIN_ADDRESS", "namespace_id": "1004", "simple": { "limit": 3, "period": 60 } },
			{ "name": "RL_QR_START", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
			{ "name": "RL_SYNC_MEMBERSHIP", "namespace_id": "1006", "simple": { "limit": 3, "period": 60 } },
			{ "name": "RL_PIN_ATTEMPT", "namespace_id": "1007", "simple": { "limit": 40, "period": 60 } }
		]
	},
	// Keep variables set in the dashboard (Settings → Variables and Secrets) across deploys.
	// Secrets are always kept; this also keeps plain-text vars.
	"keep_vars": true,
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": ["0 * * * *"]
	}
}
